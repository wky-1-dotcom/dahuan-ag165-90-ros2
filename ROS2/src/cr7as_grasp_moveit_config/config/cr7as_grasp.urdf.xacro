<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cr7as_grasp">
  <!-- MoveIt and Gazebo use the same AG165 robot description. Gazebo tags and
       the GazeboSystem plugin are ignored by MoveIt but keep the model contract identical. -->
  <xacro:include filename="$(find cr7as_grasp)/urdf/cr7as_ag165_gazebo.urdf.xacro" />
</robot>
