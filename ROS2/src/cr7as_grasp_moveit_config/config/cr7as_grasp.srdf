<?xml version="1.0"?>
<robot name="cr7as_grasp">
  <group name="ARM">
    <chain base_link="b0" tip_link="grasp_tcp" />
  </group>
  <group name="gripper">
    <joint name="ag165_joint1_left" />
  </group>
  <group_state name="open" group="gripper">
    <joint name="ag165_joint1_left" value="0.0" />
  </group_state>
  <group_state name="close" group="gripper">
    <joint name="ag165_joint1_left" value="0.62" />
  </group_state>
  <end_effector name="ag165_gripper" parent_link="grasp_tcp" group="gripper" parent_group="ARM" />
  <passive_joint name="ag165_joint2_left" />
  <passive_joint name="ag165_joint3_left" />
  <passive_joint name="ag165_joint1_right" />
  <passive_joint name="ag165_joint2_right" />
  <passive_joint name="ag165_joint3_right" />
  <!-- Preserve the CR7AS arm's original adjacent-link exclusions after the
       AG165 migration. Non-adjacent arm links remain collision checked. -->
  <disable_collisions link1="b0" link2="l1" reason="Adjacent" />
  <disable_collisions link1="l1" link2="l2" reason="Adjacent" />
  <disable_collisions link1="l2" link2="l3" reason="Adjacent" />
  <disable_collisions link1="l3" link2="l4" reason="Adjacent" />
  <disable_collisions link1="l4" link2="l5" reason="Adjacent" />
  <disable_collisions link1="l5" link2="l6" reason="Adjacent" />
  <disable_collisions link1="l6" link2="gripper_base" reason="Adjacent" />
  <!-- Both links are rigidly mounted through gripper_base; their mounting
       collision meshes overlap in the assembled robot. Keep all other
       arm/gripper and gripper/object collision checks enabled. -->
  <disable_collisions link1="l6" link2="ag165_base_link" reason="Adjacent" />
  <disable_collisions link1="gripper_base" link2="ag165_base_link" reason="Adjacent" />
  <disable_collisions link1="ag165_base_link" link2="ag165_link1_left" reason="Adjacent" />
  <disable_collisions link1="ag165_base_link" link2="ag165_link1_right" reason="Adjacent" />
  <disable_collisions link1="ag165_link1_left" link2="ag165_link2_left" reason="Adjacent" />
  <disable_collisions link1="ag165_link1_right" link2="ag165_link2_right" reason="Adjacent" />
  <disable_collisions link1="ag165_link2_left" link2="ag165_link3_left" reason="Adjacent" />
  <disable_collisions link1="ag165_link2_right" link2="ag165_link3_right" reason="Adjacent" />
  <disable_collisions link1="ag165_link3_left" link2="ag165_base_link" reason="Adjacent" />
  <disable_collisions link1="ag165_link3_right" link2="ag165_base_link" reason="Adjacent" />
</robot>
